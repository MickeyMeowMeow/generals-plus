{
  "name": "@generals-plus/shared-types",
  "private": true,
  "version": "0.1.0",
  "exports": {
    ".": {
      "default": "./dist/index.mjs",
      "types": "./src/index.ts"
    }
  },
  "imports": {
    "#/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "build": "tsdown src/index.ts",
    "dev": "tsdown src/index.ts --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@colyseus/schema": "^4.0.20",
    "@generals-plus/engine": "workspace:*",
    "colyseus": "^0.17.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@generals-plus/typescript-config": "workspace:*",
    "tsdown": "^0.21.10",
    "vitest": "^4.1.5"
  }
}
